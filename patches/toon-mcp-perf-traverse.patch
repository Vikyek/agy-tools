---
 src/patterns.py       | 22 +++++++++++++---------
 src/toon_converter.py | 19 ++++++++++++-------
 2 files changed, 25 insertions(+), 16 deletions(-)

diff --git a/src/patterns.py b/src/patterns.py
index 1b65f1d..c85d1f6 100644
--- a/src/patterns.py
+++ b/src/patterns.py
@@ -93,16 +93,20 @@ class PatternDetector:

         return sorted(self.detected_patterns, key=lambda p: p.confidence, reverse=True)

-    def _traverse(self, data: Any, path: str = '') -> None:
+    def _traverse(self, data: Any) -> None:
         """Traverse data and collect key statistics."""
-        if isinstance(data, dict):
-            for key, value in data.items():
-                self.key_frequency[key] += 1
-                self._traverse(value, f"{path}.{key}")
-
-        elif isinstance(data, list):
-            for i, item in enumerate(data):
-                self._traverse(item, f"{path}[{i}]")
+        stack = [data]
+        while stack:
+            current = stack.pop()
+            if isinstance(current, dict):
+                if isinstance(self.key_frequency, Counter):
+                    self.key_frequency.update(current.keys())
+                else:
+                    for key in current:
+                        self.key_frequency[key] += 1
+                stack.extend(current.values())
+            elif isinstance(current, list):
+                stack.extend(current)

     def _detect_api_response(self, data: Any) -> None:
         """Detect API response patterns."""
diff --git a/src/toon_converter.py b/src/toon_converter.py
index a93915a..8020ba4 100644
--- a/src/toon_converter.py
+++ b/src/toon_converter.py
@@ -107,13 +107,18 @@ class TOONConverter:

     def _build_ref_cache(self, data: Any) -> None:
         """Traverse data and collect key frequencies for aggressive-mode abbreviation."""
-        if isinstance(data, dict):
-            for key, value in data.items():
-                self.key_freq[key] += 1
-                self._build_ref_cache(value)
-        elif isinstance(data, list):
-            for item in data:
-                self._build_ref_cache(item)
+        stack = [data]
+        while stack:
+            current = stack.pop()
+            if isinstance(current, dict):
+                if isinstance(self.key_freq, Counter):
+                    self.key_freq.update(current.keys())
+                else:
+                    for key in current:
+                        self.key_freq[key] += 1
+                stack.extend(current.values())
+            elif isinstance(current, list):
+                stack.extend(current)

     def _build_custom_abbrev(self) -> Dict[str, str]:
         """
