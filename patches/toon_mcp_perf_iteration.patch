         if not arr:
             return 0.0

-        # Get all unique key sets
-        key_sets = [set(item.keys()) for item in arr if isinstance(item, dict)]
-
-        if not key_sets:
+        valid_items = [item for item in arr if isinstance(item, dict)]
+        if not valid_items:
             return 0.0

+        # Fast path for perfectly homogeneous arrays
+        first_keys = valid_items[0].keys()
